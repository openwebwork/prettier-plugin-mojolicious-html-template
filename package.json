{
    "name": "@openwebwork/prettier-plugin-mojolicious-html-template",
    "version": "0.0.3",
    "description": "Prettier Mojolicious template file plugin",
    "author": "The WeBWorK Project",
    "license": "LGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openwebwork/prettier-plugin-mojolicious-html-template.git"
    },
    "homepage": "https://github.com/openwebwork/prettier-plugin-mojolicious-html-template",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "generate-grammar": "lezer-generator src/mojo/mojo.grammar -o src/mojo/mojo.grammar.js",
        "prebuild": "npm run generate-grammar",
        "build": "tsc",
        "postbuild": "cp src/mojo/perltidy-worker.pl dist/mojo/perltidy-worker.pl",
        "watch": "tsc -w",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "pretest": "npm run generate-grammar",
        "test": "vitest run",
        "pretest:watch": "npm run generate-grammar",
        "test:watch": "vitest",
        "pretest:update": "npm run generate-grammar",
        "test:update": "vitest run --update"
    },
    "dependencies": {
        "@lezer/lr": "^1.4.11"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@lezer/generator": "^1.8.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "prettier": "3.9.4 - 3.9.10"
    }
}
